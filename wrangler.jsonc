/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "people-rate-you",
	"compatibility_date": "2025-10-08",
	"compatibility_flags": ["nodejs_compat"],
	"main": "@tanstack/react-start/server-entry",
	"vars": {
		"VALUE_FROM_CLOUDFLARE": "Hello from Hono/CF"
	},
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "people-rate-you-db",
			"database_id": "760b9258-5db9-4b01-99c8-db775be67e92",
			"migrations_dir": "migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "PHOTOS",
			"bucket_name": "people-rate-you-photos"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"ai": {
		"binding": "AI",
		"remote": true
	},
	"assets": {
		"directory": "./public/",
		"binding": "ASSETS"
	},
	"ratelimits": [
		{
			"name": "UPLOAD_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "VIEW_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 60, "period": 60 }
		},
		{
			"name": "AUTH_RATE_LIMITER",
			"namespace_id": "1003",
			"simple": { "limit": 10, "period": 60 }
		},
		{
			"name": "RATING_RATE_LIMITER",
			"namespace_id": "1004",
			"simple": { "limit": 20, "period": 60 }
		},
		{
			"name": "COMMENT_RATE_LIMITER",
			"namespace_id": "1005",
			"simple": { "limit": 5, "period": 60 }
		},
		{
			"name": "VERIFICATION_RATE_LIMITER",
			"namespace_id": "1006",
			"simple": { "limit": 2, "period": 60 }
		}
	],
	/**
	 * "local" environment: everything runs against local Miniflare
	 * simulators (D1, R2, images, ratelimits), no Cloudflare account
	 * needed. It deliberately omits the "ai" binding, since Workers AI
	 * has no local simulator and would otherwise force a remote proxy
	 * session (and a CLOUDFLARE_API_TOKEN) just to start the dev server.
	 *
	 * Selected via `CLOUDFLARE_ENV=local` (see the "dev" script in
	 * package.json). Bindings are non-inheritable, so every binding we
	 * want available locally has to be repeated here.
	 *
	 * Anything that touches the AI binding (currently only photo
	 * moderation in src/server/moderation.ts) will throw at runtime under
	 * this environment. Use `npm run dev:remote` instead when you need
	 * that path and have a CLOUDFLARE_API_TOKEN set.
	 */
	"env": {
		"local": {
			"vars": {
				"VALUE_FROM_CLOUDFLARE": "Hello from Hono/CF"
			},
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "people-rate-you-db",
					"database_id": "760b9258-5db9-4b01-99c8-db775be67e92",
					"migrations_dir": "migrations"
				}
			],
			"r2_buckets": [
				{
					"binding": "PHOTOS",
					"bucket_name": "people-rate-you-photos"
				}
			],
			"images": {
				"binding": "IMAGES"
			},
			"assets": {
				"directory": "./public/",
				"binding": "ASSETS"
			},
			"ratelimits": [
				{
					"name": "UPLOAD_RATE_LIMITER",
					"namespace_id": "1001",
					"simple": { "limit": 5, "period": 60 }
				},
				{
					"name": "VIEW_RATE_LIMITER",
					"namespace_id": "1002",
					"simple": { "limit": 60, "period": 60 }
				},
				{
					"name": "AUTH_RATE_LIMITER",
					"namespace_id": "1003",
					"simple": { "limit": 10, "period": 60 }
				},
				{
					"name": "RATING_RATE_LIMITER",
					"namespace_id": "1004",
					"simple": { "limit": 20, "period": 60 }
				},
				{
					"name": "COMMENT_RATE_LIMITER",
					"namespace_id": "1005",
					"simple": { "limit": 5, "period": 60 }
				},
				{
					"name": "VERIFICATION_RATE_LIMITER",
					"namespace_id": "1006",
					"simple": { "limit": 2, "period": 60 }
				}
			]
		}
	},
	/**
	 * Smart Placement
	 * Docs: https://developers.cloudflare.com/workers/configuration/smart-placement/#smart-placement
	 */
	// "placement": { "mode": "smart" },
	/**
	 * Bindings
	 * Bindings allow your Worker to interact with resources on the Cloudflare Developer Platform, including
	 * databases, object storage, AI inference, real-time communication and more.
	 * https://developers.cloudflare.com/workers/runtime-apis/bindings/
	 */
	/**
	 * Environment Variables
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#environment-variables
	 */
	// "vars": { "MY_VARIABLE": "production_value" },
	/**
	 * Note: Use secrets to store sensitive data.
	 * https://developers.cloudflare.com/workers/configuration/secrets/
	 */
	/**
	 * Service Bindings (communicate between multiple Workers)
	 * https://developers.cloudflare.com/workers/wrangler/configuration/#service-bindings
	 */
	// "services": [{ "binding": "MY_SERVICE", "service": "my-service" }]
	"upload_source_maps": true
}
